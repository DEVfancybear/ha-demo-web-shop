# Tên hiển thị của cửa hàng
NEXT_PUBLIC_SITE_NAME=ShopHA
# Hotline hiển thị trên header/footer
NEXT_PUBLIC_HOTLINE=1900 0000
# URL công khai (canonical, JSON-LD, sitemap, robots) — đổi khi deploy
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# File SQLite cho đơn hàng, tồn kho biến thể, đánh giá (mặc định .data/shop.db)
SHOP_DB_PATH=.data/shop.db
